<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>application-identifier</key><string>com.example.novabrowser</string>
    <key>com.apple.private.security.no-sandbox</key><true/>
    <key>platform-application</key><true/>
    <key>com.apple.private.security.storage.AppDataContainers</key><true/>
    <!-- dynamic-codesigning is deliberately NOT granted: it can prevent launch on A12+.
         WKWebView uses the system WebContent process and does not need this entitlement.
         IOKit exceptions are omitted because this app uses no direct IOKit clients. -->
</dict></plist>
