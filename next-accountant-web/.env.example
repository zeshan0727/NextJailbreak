# Copy to .env on the SERVER only. Never commit the real .env.
POSTGRES_DB=nextaccountant
POSTGRES_USER=nextaccountant
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
APP_BASE_URL=https://accounts.nextjailbreak.com

# Object storage
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=next-accountant-documents
